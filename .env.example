# Shorter Environment Variables

# Datastore: LOKI Postgres ONLY (per-tenant DBs: foundation_barber_<tenant_id>).
# Set on the server in .env.production - never commit real values.
VITE_LOKI_HOST=
VITE_LOKI_PORT=5432
VITE_LOKI_USER=
VITE_LOKI_PASSWORD=

# Absolute API base. REQUIRED for the native iOS build (Capacitor serves from
# capacitor://localhost, so relative /api paths would not reach the server).
VITE_API_URL=

# Barber-uploaded images (avatars + work gallery)
UPLOAD_DIR=/opt/htf/barber-app/uploads


# Gemini API Key (Injected by AI Studio)
GEMINI_API_KEY=

# App URL (Injected by AI Studio)
APP_URL=
