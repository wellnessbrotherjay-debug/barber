node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# AI tooling state — never belongs in the repository (RULES_NO_LOCAL_AI_FILES)
.claude/

# Capacitor copies the built web bundle in here on every sync - generated
# output, never source, and scanning it reports the bundler own code as ours.
android/app/src/main/assets/public/

# Superseded schema dumps. The schema is migrations/, applied in order;
# these hand-kept copies had drifted behind the real database.
docs/DATABASE_SCHEMA.sql
docs/ADMIN_DATABASE_SCHEMA.sql

# Capacitor scaffold example tests - never written, never run.
android/app/src/androidTest/
android/app/src/test/

# Superseded deployment guides and progress snapshots. They named databases
# that were renamed on 26 August 2026, so following them built the wrong thing.
# The current documentation is the README in each folder.
BACKEND_SETUP.md
DEPLOYMENT_COMPLETE.md
DEPLOYMENT_QUICKSTART.md
PROJECT_COMPLETE.txt
docs/LOKI_SETUP_GUIDE.md
docs/PROJECT_STATUS.md
docs/MULTITENANT_PROJECT_STATUS.md

# Android signing key. It lives in the secrets store, never here - losing it
# means the app can never be updated, and committing it means anyone can
# publish as us.
*.jks
*.keystore
keystore.properties
